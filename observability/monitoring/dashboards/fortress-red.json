{
  "title": "Fortress RED",
  "schemaVersion": 39,
  "version": 1,
  "templating": {"list": []},
  "panels": [
    {"type": "timeseries", "title": "Request rate", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "sum by (route) (rate(fortress_http_requests_total[5m]))", "legendFormat": "{{route}}"}]},
    {"type": "timeseries", "title": "Error ratio", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "sum(rate(fortress_http_requests_total{status_class=\"5xx\"}[5m])) / sum(rate(fortress_http_requests_total[5m]))", "legendFormat": "5xx"}]},
    {"type": "timeseries", "title": "p95 latency", "gridPos": {"x": 0, "y": 8, "w": 24, "h": 8}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(fortress_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95"}]}
  ]
}
