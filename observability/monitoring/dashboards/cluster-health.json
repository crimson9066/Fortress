{
  "title": "Cluster health",
  "schemaVersion": 39,
  "version": 1,
  "templating": {"list": []},
  "panels": [
    {"type": "stat", "title": "Ready nodes", "gridPos": {"x": 0, "y": 0, "w": 8, "h": 6}, "targets": [{"expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})"}]},
    {"type": "timeseries", "title": "Pod restarts", "gridPos": {"x": 8, "y": 0, "w": 16, "h": 8}, "targets": [{"expr": "sum by (namespace) (rate(kube_pod_container_status_restarts_total[15m]))", "legendFormat": "{{namespace}}"}]},
    {"type": "timeseries", "title": "Unschedulable pods", "gridPos": {"x": 0, "y": 8, "w": 24, "h": 8}, "targets": [{"expr": "sum(kube_pod_status_phase{phase=\"Pending\"})"}]}
  ]
}
